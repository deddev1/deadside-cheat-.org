---
import { gameplayPreviewScreenshots } from '../data/deadside';
import { getLocalizedPath } from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { contentSrc, contentSrcSet } from '../lib/responsive-images';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;

const showcaseCards = gameplayPreviewScreenshots.map((shot) => ({
	badge: shot.badge,
	badgeTone: shot.badgeTone,
	title: shot.title,
	description: shot.description,
	image: shot,
	href: getLocalizedPath(shot.pageId, locale),
}));

const scrollCards = [...showcaseCards, ...showcaseCards];
---

<section class="cheat-showcase" aria-labelledby="cheat-showcase-title">
	<div class="cheat-showcase__fade" aria-hidden="true"></div>

	<div class="shell cheat-showcase__inner">
		<header class="cheat-showcase__head">
			<div class="cheat-showcase__head-copy">
				<h2 id="cheat-showcase-title" class="cheat-showcase__title">
					<span class="cheat-showcase__accent" aria-hidden="true"></span>
					Cheat showcase
				</h2>
				<p class="cheat-showcase__lead">
					Live Deadside gameplay previews — ESP, wallhack, aimbot, radar, and menu shots from the Windows PC
					package.
				</p>
			</div>
		</header>
	</div>

	<div class="cheat-showcase__stage">
		<div class="cheat-showcase__viewport" data-cheat-scroll-viewport>
			<div class="cheat-showcase__track" data-cheat-scroll-track>
					{
						scrollCards.map((card) => {
							const imageSrc = contentSrc(card.image.src);
							const imageSrcSet = contentSrcSet(card.image.src);

							return (
								<article class="cheat-showcase__card">
									<a href={card.href} class="cheat-showcase__card-link">
										<div class="cheat-showcase__media">
											<img
												src={imageSrc}
												{...(imageSrcSet ? { srcset: imageSrcSet } : {})}
												sizes="(max-width: 560px) 78vw, 320px"
												alt={card.image.alt}
												title={card.image.title}
												width="530"
												height="320"
												loading="lazy"
												decoding="async"
											/>
										</div>
									<div class="cheat-showcase__body">
										<div class="cheat-showcase__meta">
											<span class:list={['cheat-showcase__badge', `cheat-showcase__badge--${card.badgeTone}`]}>
												{card.badge}
											</span>
											<span class="cheat-showcase__label">Windows PC</span>
										</div>
										<h3 class="cheat-showcase__card-title">{card.title}</h3>
										<p class="cheat-showcase__card-desc">{card.description}</p>
									</div>
								</a>
							</article>
							);
						})
					}
				</div>
			</div>
		</div>
</section>

<script>
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	for (const viewport of document.querySelectorAll('[data-cheat-scroll-viewport]')) {
		if (!(viewport instanceof HTMLElement)) continue;
		const track = viewport.querySelector('[data-cheat-scroll-track]');
		if (!(track instanceof HTMLElement)) continue;

		const speedNormal = reduceMotion ? 0 : 1.22;
		const speedHover = reduceMotion ? 0 : 0.14;
		let targetSpeed = speedNormal;
		let currentSpeed = speedNormal;
		let raf = 0;

		const tick = () => {
			currentSpeed += (targetSpeed - currentSpeed) * 0.09;
			if (currentSpeed > 0.001) {
				viewport.scrollLeft += currentSpeed;
				const half = track.scrollWidth / 2;
				if (half > 0 && viewport.scrollLeft >= half) {
					viewport.scrollLeft -= half;
				}
			}
			raf = requestAnimationFrame(tick);
		};

		viewport.addEventListener('pointerenter', () => {
			targetSpeed = speedHover;
		});
		viewport.addEventListener('pointerleave', () => {
			targetSpeed = speedNormal;
		});

		raf = requestAnimationFrame(tick);
	}
</script>

<style>
	.cheat-showcase {
		position: relative;
		padding: clamp(1.5rem, 3vw, 2.25rem) 0 clamp(2rem, 4vw, 3rem);
		overflow: hidden;
		background: linear-gradient(180deg, rgba(8, 10, 12, 0.2) 0%, rgba(4, 5, 7, 0.95) 100%);
	}

	.cheat-showcase__fade {
		pointer-events: none;
		position: absolute;
		inset: 0;
		background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(111, 143, 58, 0.08), transparent 70%);
	}

	.cheat-showcase__inner {
		position: relative;
		z-index: 1;
	}

	.cheat-showcase__head {
		margin-bottom: 1.25rem;
		text-align: center;
	}

	.cheat-showcase__title {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		margin: 0;
		font-family: var(--font-sans);
		font-size: clamp(1.35rem, 3vw, 1.85rem);
		font-weight: 800;
		letter-spacing: -0.02em;
		text-transform: uppercase;
		color: #f5e6c8;
	}

	.cheat-showcase__accent {
		display: inline-block;
		width: 0.35rem;
		height: 1.35rem;
		border-radius: 2px;
		background: linear-gradient(180deg, #e8b96a, #9a6a2e);
	}

	.cheat-showcase__lead {
		margin: 0.65rem auto 0;
		max-width: 42rem;
		font-size: 0.95rem;
		line-height: 1.55;
		color: rgba(235, 220, 190, 0.78);
	}

	.cheat-showcase__stage {
		position: relative;
		z-index: 1;
	}

	.cheat-showcase__viewport {
		overflow-x: auto;
		overflow-y: hidden;
		scrollbar-width: none;
		mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
	}

	.cheat-showcase__viewport::-webkit-scrollbar {
		display: none;
	}

	.cheat-showcase__track {
		display: flex;
		gap: 1rem;
		width: max-content;
		padding: 0.25rem clamp(1rem, 4vw, 2rem) 0.5rem;
	}

	.cheat-showcase__card {
		flex: 0 0 auto;
		width: min(320px, 78vw);
	}

	.cheat-showcase__card-link {
		display: flex;
		flex-direction: column;
		height: 100%;
		border-radius: 0.5rem;
		border: 1px solid rgba(111, 143, 58, 0.22);
		background: rgba(12, 14, 18, 0.92);
		text-decoration: none;
		color: inherit;
		overflow: hidden;
		transition:
			border-color 0.2s ease,
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}

	.cheat-showcase__card-link:hover {
		border-color: rgba(232, 185, 106, 0.45);
		transform: translateY(-2px);
		box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
	}

	.cheat-showcase__media {
		aspect-ratio: 530 / 320;
		overflow: hidden;
		background: #0a0c0f;
	}

	.cheat-showcase__media img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center top;
	}

	.cheat-showcase__body {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		padding: 0.85rem 0.95rem 1rem;
	}

	.cheat-showcase__meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.cheat-showcase__badge {
		display: inline-flex;
		padding: 0.2rem 0.45rem;
		border-radius: 999px;
		font-size: 0.62rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.cheat-showcase__badge--green {
		background: rgba(72, 160, 96, 0.18);
		color: #8fd9a0;
		border: 1px solid rgba(120, 200, 140, 0.35);
	}

	.cheat-showcase__badge--gold {
		background: rgba(111, 143, 58, 0.14);
		color: #b8d080;
		border: 1px solid rgba(111, 143, 58, 0.35);
	}

	.cheat-showcase__label {
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: rgba(200, 190, 170, 0.55);
	}

	.cheat-showcase__card-title {
		margin: 0;
		font-size: 0.92rem;
		font-weight: 800;
		line-height: 1.3;
		color: #f2e4c6;
	}

	.cheat-showcase__card-desc {
		margin: 0;
		font-size: 0.78rem;
		line-height: 1.45;
		color: rgba(220, 205, 180, 0.72);
	}
</style>
