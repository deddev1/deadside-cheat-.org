---
import Layout from '../layouts/Layout.astro';
import Navbar from './Navbar.astro';
import SiteFooter from './SiteFooter.astro';
import { blogUi, type LocaleCode } from '../data/i18n/locales';
import {
	absoluteBlogUrl,
	getBlogBasePath,
	getRelatedPosts,
	isGameGuidePost,
} from '../data/blog/helpers';
import type { ResolvedBlogPost } from '../data/blog/types';
import { siteConfig } from '../data/site';
import RelatedPages from './RelatedPages.astro';
import { getUi } from '../data/i18n';
import { getLocalizedPath } from '../data/i18n/routing';
import { getBlogProductLinks } from '../lib/internal-links';

interface Props {
	locale: LocaleCode;
	post: ResolvedBlogPost;
}

const { locale, post } = Astro.props;
const ui = blogUi[locale];
const navUi = getUi(locale);
const productLinks = getBlogProductLinks(locale, {
	esp: navUi.nav.esp,
	aimbot: navUi.nav.aimbot,
	features: navUi.nav.features,
	setup: navUi.nav.setup,
	pricing: navUi.nav.pricing,
	updates: navUi.nav.updates,
	faq: navUi.nav.faq,
});
const t = post.translation;
const homeHref = getLocalizedPath('home', locale);
const blogHref = getBlogBasePath(locale);
const pricingHref = getLocalizedPath('pricing', locale);
const setupHref = getLocalizedPath('setup', locale);
const isGameGuide = isGameGuidePost(post);
const hubHref = blogHref;
const hubLabel = isGameGuide ? 'Deadside game guides' : ui.blogH1;
const related = getRelatedPosts(locale, post, 3);
const sectionNav = t.sections.map((section, index) => ({
	id: `section-${index + 1}`,
	label: section.h2,
}));

const articleUrl = absoluteBlogUrl(locale, t.slug);
const articleSchema = {
	'@type': 'Article',
	'@id': `${articleUrl}#article`,
	headline: t.title,
	description: t.metaDescription,
	datePublished: post.published,
	dateModified: post.updated,
	image: new URL(post.imageSrc, siteConfig.url).href,
	inLanguage: 'en',
	author: { '@type': 'Organization', name: siteConfig.name, url: siteConfig.url },
	publisher: {
		'@type': 'Organization',
		name: siteConfig.name,
		url: siteConfig.url,
		logo: { '@type': 'ImageObject', url: new URL(siteConfig.logoRaster, siteConfig.url).href },
	},
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': `${articleUrl}#webpage`,
	},
	isPartOf: { '@id': `${siteConfig.url}/#website` },
	keywords: t.keywords.join(', '),
	articleSection: post.category,
};

function localizeParagraphHtml(html: string): string {
	return html.replace(/href="(\/[^"]+)"/g, (_, path: string) => {
		if (path.startsWith('/blog')) return `href="${path}"`;
		return `href="${path}"`;
	});
}

function pageTitle(headline: string): string {
	const suffix = ' | Deadside Cheats';
	if (headline.length + suffix.length <= 60) return `${headline}${suffix}`;
	if (headline.length <= 60) return headline;
	const trimmed = headline.slice(0, 57);
	const cut = trimmed.lastIndexOf(' ');
	return `${(cut > 40 ? trimmed.slice(0, cut) : trimmed).replace(/[|:–—-]+$/, '').trim()}…`;
}
---

<Layout
	title={pageTitle(t.title)}
	description={t.metaDescription}
	canonicalPath={post.canonicalPath}
	ogImage={post.imageSrc}
	ogImageAlt={t.imageAlt}
	type="article"
	locale={locale}
	englishOnlyAlternates={true}
	noindex={false}
	breadcrumbs={[
		{ label: ui.home, href: homeHref },
		{ label: hubLabel, href: hubHref },
		{ label: t.h1 },
	]}
	extraGraph={[articleSchema]}
>
	<Navbar locale={locale} />
	<main class="post-page">
		<div class="shell post-page__shell">
			<article class="post-article">
				<header class="post-article__header">
					<p class="post-article__cat">{post.category}</p>
					<h1>{t.h1}</h1>
					<p class="post-article__intro">{t.intro}</p>
					<p class="post-article__meta">
						<span>{ui.published} {post.published}</span>
						<span aria-hidden="true">·</span>
						<span>{ui.updated} {post.updated}</span>
					</p>
				</header>

				<div class="post-article__hero">
					<img
						src={post.imageSrc}
						alt={t.imageAlt}
						width="1200"
						height="675"
						loading="eager"
						decoding="async"
						fetchpriority="high"
					/>
				</div>

				<aside class="post-article__cta" aria-label="Get Deadside Cheats">
					<p class="post-article__cta-title">Ready to run ESP, aimbot, and radar on PC?</p>
					<div class="post-article__cta-actions">
						<a class="post-article__cta-primary" href={siteConfig.checkoutUrl} rel="noopener noreferrer">
							Get access
						</a>
						<a class="post-article__cta-ghost" href={pricingHref}>Pricing</a>
						<a class="post-article__cta-ghost" href={setupHref}>Setup</a>
					</div>
				</aside>

				{
					sectionNav.length > 1 && (
						<nav class="post-article__toc" aria-label="On this page">
							<p class="post-article__toc-label">On this page</p>
							<ol>
								{sectionNav.map((item) => (
									<li>
										<a href={`#${item.id}`}>{item.label}</a>
									</li>
								))}
							</ol>
						</nav>
					)
				}

				<div class="post-article__body">
					{
						t.sections.map((section, index) => (
							<section class="post-article__section" id={`section-${index + 1}`}>
								<h2>{section.h2}</h2>
								{section.paragraphs.map((paragraph) => {
									const isTip = paragraph.startsWith('Pro Tip');
									const isTry = paragraph.startsWith('Try This Today');
									const html = localizeParagraphHtml(paragraph);
									if (isTip || isTry) {
										return (
											<aside class:list={['post-callout', { 'post-callout--tip': isTip, 'post-callout--try': isTry }]}>
												<p set:html={html} />
											</aside>
										);
									}
									return <p set:html={html} />;
								})}
							</section>
						))
					}
				</div>
			</article>

			{
				related.length > 0 && (
					<section class="post-related" aria-label={ui.relatedPosts}>
						<h2>{ui.relatedPosts}</h2>
						<ul class="post-related__grid">
							{related.map((item) => (
								<li>
									<a class="post-related__card" href={item.canonicalPath}>
										<span class="post-related__card-cat">{item.category}</span>
										<span class="post-related__card-title">{item.translation.title}</span>
									</a>
								</li>
							))}
						</ul>
					</section>
				)
			}

			<RelatedPages locale={locale} links={productLinks} title="Explore Deadside Cheats" />
		</div>
	</main>
	<SiteFooter locale={locale} />
</Layout>

<style>
	.post-page {
		padding-block: clamp(1.25rem, 3vw, 2rem) clamp(2.5rem, 5vw, 4rem);
		background:
			radial-gradient(ellipse 80% 50% at 50% 0%, rgba(111, 143, 58, 0.06), transparent 55%),
			var(--color-bg);
	}

	.post-page__shell {
		display: grid;
		gap: clamp(1.5rem, 3vw, 2.25rem);
	}

	.post-article {
		border: 1px solid var(--color-border-subtle);
		background: rgba(23, 29, 24, 0.72);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		box-shadow: var(--shadow-soft);
	}

	.post-article__header {
		padding: clamp(1.25rem, 3vw, 1.75rem) clamp(1.15rem, 3vw, 1.65rem) 0;
	}

	.post-article__cat {
		margin: 0 0 0.5rem;
		color: var(--color-gold-hover);
		font-family: var(--font-display);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.post-article__header h1 {
		margin: 0 0 0.85rem;
		font-family: var(--font-display);
		font-size: clamp(1.65rem, 4.2vw, 2.35rem);
		font-weight: 800;
		line-height: 1.12;
		letter-spacing: 0.01em;
		color: #fff;
	}

	.post-article__intro {
		margin: 0;
		max-width: 42rem;
		color: rgba(255, 255, 255, 0.88);
		font-size: clamp(0.95rem, 1.35vw, 1.05rem);
		line-height: 1.65;
	}

	.post-article__meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 0.5rem;
		margin: 0.85rem 0 0;
		color: var(--color-muted);
		font-size: 0.8rem;
	}

	.post-article__hero {
		margin: 1.15rem clamp(1.15rem, 3vw, 1.65rem) 0;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: var(--radius-media);
	}

	.post-article__hero img {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
	}

	.post-article__cta {
		display: grid;
		gap: 0.75rem;
		margin: 1.15rem clamp(1.15rem, 3vw, 1.65rem) 0;
		padding: 0.9rem 1rem;
		border: 1px solid rgba(111, 143, 58, 0.35);
		border-radius: var(--radius-card);
		background: rgba(17, 22, 18, 0.65);
	}

	.post-article__cta-title {
		margin: 0;
		font-family: var(--font-display);
		font-size: 0.92rem;
		font-weight: 700;
		color: #fff;
	}

	.post-article__cta-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.post-article__cta-primary,
	.post-article__cta-ghost {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.35rem;
		padding: 0.45rem 0.9rem;
		border-radius: 0.2rem;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		text-decoration: none;
		transition:
			background 0.2s ease,
			border-color 0.2s ease,
			color 0.2s ease;
	}

	.post-article__cta-primary {
		background: var(--color-button);
		border: 1px solid rgba(111, 143, 58, 0.5);
		color: #fff;
	}

	.post-article__cta-primary:hover {
		background: var(--color-button-hover);
		color: #fff;
	}

	.post-article__cta-ghost {
		border: 1px solid rgba(255, 255, 255, 0.18);
		background: transparent;
		color: rgba(255, 255, 255, 0.9);
	}

	.post-article__cta-ghost:hover {
		border-color: rgba(255, 255, 255, 0.32);
		color: #fff;
	}

	.post-article__toc {
		margin: 1.15rem clamp(1.15rem, 3vw, 1.65rem) 0;
		padding: 0.85rem 1rem;
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: var(--radius-card);
		background: rgba(0, 0, 0, 0.22);
	}

	.post-article__toc-label {
		margin: 0 0 0.5rem;
		color: var(--color-muted);
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.post-article__toc ol {
		margin: 0;
		padding-left: 1.15rem;
		display: grid;
		gap: 0.35rem;
	}

	.post-article__toc a {
		color: rgba(255, 255, 255, 0.86);
		font-size: 0.88rem;
		text-decoration: none;
	}

	.post-article__toc a:hover {
		color: var(--color-gold-hover);
		text-decoration: underline;
	}

	.post-article__body {
		padding: 1.15rem clamp(1.15rem, 3vw, 1.65rem) clamp(1.35rem, 3vw, 1.85rem);
	}

	.post-article__section {
		margin-bottom: 1.65rem;
	}

	.post-article__section:last-child {
		margin-bottom: 0;
	}

	.post-article__section h2 {
		margin: 0 0 0.75rem;
		font-family: var(--font-display);
		font-size: clamp(1.1rem, 2.2vw, 1.28rem);
		font-weight: 800;
		color: #fff;
		letter-spacing: 0.02em;
	}

	.post-article__section p {
		margin: 0 0 0.9rem;
		color: rgba(255, 255, 255, 0.86);
		font-size: 0.95rem;
		line-height: 1.72;
	}

	.post-article__section :global(a) {
		color: var(--color-gold-hover);
		text-decoration: underline;
		text-underline-offset: 0.14em;
	}

	.post-article__section :global(a:hover) {
		color: #fff;
	}

	.post-callout {
		margin: 0 0 1rem;
		padding: 0.9rem 1rem;
		border-radius: var(--radius-card);
		border: 1px solid rgba(111, 143, 58, 0.35);
		background: rgba(111, 143, 58, 0.08);
	}

	.post-callout--try {
		border-color: rgba(213, 138, 50, 0.35);
		background: rgba(213, 138, 50, 0.08);
	}

	.post-callout p {
		margin: 0;
		color: rgba(255, 255, 255, 0.94);
		font-size: 0.92rem;
		line-height: 1.65;
	}

	.post-callout :global(a) {
		color: var(--color-gold-hover);
	}

	.post-related {
		padding-top: 0.25rem;
	}

	.post-related h2 {
		margin: 0 0 0.85rem;
		font-family: var(--font-display);
		font-size: 1.05rem;
		font-weight: 800;
		color: #fff;
	}

	.post-related__grid {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.65rem;
	}

	.post-related__card {
		display: grid;
		gap: 0.35rem;
		height: 100%;
		padding: 0.85rem 0.9rem;
		border: 1px solid var(--color-border-subtle);
		border-radius: var(--radius-card);
		background: rgba(23, 29, 24, 0.55);
		text-decoration: none;
		transition:
			border-color 0.2s ease,
			background 0.2s ease,
			transform 0.2s ease;
	}

	.post-related__card:hover {
		border-color: rgba(142, 173, 74, 0.4);
		background: rgba(23, 29, 24, 0.85);
		transform: translateY(-1px);
	}

	.post-related__card-cat {
		color: var(--color-muted);
		font-size: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.post-related__card-title {
		color: #fff;
		font-size: 0.86rem;
		font-weight: 700;
		line-height: 1.35;
	}

	@media (max-width: 820px) {
		.post-related__grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 560px) {
		.post-article__cta-actions {
			flex-direction: column;
		}

		.post-article__cta-primary,
		.post-article__cta-ghost {
			width: 100%;
		}
	}
</style>
