---
import { getUi } from '../data/i18n';
import { getLocalizedPath } from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { siteConfig } from '../data/site';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const ui = getUi(locale);
const homeHref = getLocalizedPath('home', locale);
const pricingHref = getLocalizedPath('pricing', locale);

const exploreLinks = [
	{ label: ui.nav.cheats, href: getLocalizedPath('hacks', locale) },
	{ label: ui.nav.esp, href: getLocalizedPath('deadside-esp', locale) },
	{ label: ui.nav.aimbot, href: getLocalizedPath('deadside-aimbot', locale) },
	{ label: 'Wallhack', href: getLocalizedPath('wallhack', locale) },
	{ label: 'Radar', href: getLocalizedPath('radar', locale) },
	{ label: ui.nav.features, href: getLocalizedPath('features', locale) },
	{ label: ui.nav.pricing, href: pricingHref },
	{ label: ui.nav.setup, href: getLocalizedPath('setup', locale) },
	{ label: ui.nav.updates, href: getLocalizedPath('updates', locale) },
	{ label: ui.nav.faq, href: getLocalizedPath('faq', locale) },
	{ label: ui.nav.reviews, href: '/reviews/' },
];

const resourceLinks = [
	{ label: 'Cheats guides', href: '/blog/' },
	{ label: 'Partner guides', href: '/guides/' },
];

const helpLinks = [
	{ label: 'Support', href: getLocalizedPath('support', locale) },
	{ label: 'Privacy', href: getLocalizedPath('privacy', locale) },
	{ label: 'Terms', href: getLocalizedPath('terms', locale) },
	{ label: 'Refund', href: getLocalizedPath('refund', locale) },
];

const year = new Date().getUTCFullYear();
---

<footer class="site-footer" id="support-footer">
	<div class="shell site-footer__wrap">
		<div class="site-footer__grid">
				<div class="site-footer__brand">
					<a href={homeHref} class="site-footer__logo">
						<img
							src={siteConfig.logo}
							alt="Deadside Cheats logo"
							width="44"
							height="44"
							loading="lazy"
							decoding="async"
						/>
						<span>{ui.product.title}</span>
					</a>
					<p class="site-footer__tagline">{ui.footer.tagline}</p>
					<a class="site-footer__cta btn-buy" href={pricingHref}>{ui.nav.buyNow}</a>
				</div>

				<nav class="site-footer__col" aria-labelledby="site-footer-explore">
					<p id="site-footer-explore" class="site-footer__heading">{ui.footer.explore}</p>
					<ul class="site-footer__list">
						{
							exploreLinks.map((link) => (
								<li>
									<a href={link.href}>{link.label}</a>
								</li>
							))
						}
					</ul>
				</nav>

				<nav class="site-footer__col" aria-labelledby="site-footer-resources">
					<p id="site-footer-resources" class="site-footer__heading">Resources</p>
					<ul class="site-footer__list">
						{
							resourceLinks.map((link) => (
								<li>
									<a
										href={link.href}
										rel={link.href.startsWith('/guides/') ? 'nofollow' : undefined}
									>
										{link.label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>

				<nav class="site-footer__col" aria-labelledby="site-footer-help">
					<p id="site-footer-help" class="site-footer__heading">{ui.footer.help}</p>
					<ul class="site-footer__list">
						{
							helpLinks.map((link) => (
								<li>
									<a href={link.href}>{link.label}</a>
								</li>
							))
						}
					</ul>
				</nav>
		</div>

		<div class="site-footer__bar">
			<p class="site-footer__copy">© {year} {siteConfig.name}. Windows PC only.</p>
			<p class="site-footer__note">Not affiliated with Bad Pixel or Deadside.</p>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: auto;
		border-top: 1px solid var(--color-border-subtle);
		background: rgba(8, 10, 9, 0.55);
		padding-top: clamp(2.25rem, 4vw, 3rem);
		padding-bottom: calc(clamp(1.25rem, 3vw, 1.75rem) + env(safe-area-inset-bottom, 0px));
	}

	.site-footer__wrap {
		max-width: var(--page-max);
	}

	.site-footer__grid {
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) repeat(3, minmax(0, 1fr));
		gap: clamp(1.5rem, 3vw, 2.5rem);
		padding-bottom: clamp(1.5rem, 3vw, 2rem);
	}

	.site-footer__brand {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.75rem;
		padding-right: 0.5rem;
	}

	.site-footer__logo {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		font-family: var(--font-sans);
		font-size: 1rem;
		font-weight: 800;
		letter-spacing: -0.02em;
		color: var(--color-ink);
		transition: color 0.2s ease;
	}

	.site-footer__logo:hover {
		color: var(--color-gold-hover);
	}

	.site-footer__logo img {
		width: 2.5rem;
		height: 2.5rem;
		object-fit: contain;
	}

	.site-footer__tagline {
		margin: 0;
		max-width: 22rem;
		color: var(--color-muted);
		font-size: 0.88rem;
		line-height: 1.6;
	}

	.site-footer__cta {
		margin-top: 0.15rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.5rem;
		padding: 0.55rem 1.1rem;
		font-size: 0.82rem;
		font-weight: 700;
		text-decoration: none;
	}

	.site-footer__heading {
		margin: 0 0 0.65rem;
		font-family: var(--font-sans);
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-orchid);
	}

	.site-footer__list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.4rem;
	}

	.site-footer__list a {
		display: inline-block;
		color: rgba(255, 255, 255, 0.82);
		font-size: 0.86rem;
		font-weight: 500;
		line-height: 1.35;
		transition: color 0.2s ease;
	}

	.site-footer__list a:hover {
		color: var(--color-gold-hover);
	}

	.site-footer__bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1.25rem;
		padding-top: 1rem;
		border-top: 1px solid var(--color-border-subtle);
	}

	.site-footer__copy,
	.site-footer__note {
		margin: 0;
		font-size: 0.75rem;
		color: var(--color-faint);
		line-height: 1.45;
	}

	.site-footer__note {
		text-align: right;
		max-width: 20rem;
	}

	@media (max-width: 900px) {
		.site-footer__grid {
			grid-template-columns: 1fr 1fr;
		}

		.site-footer__brand {
			grid-column: 1 / -1;
			padding-right: 0;
		}
	}

	@media (max-width: 520px) {
		.site-footer__grid {
			grid-template-columns: 1fr;
			gap: 1.35rem;
		}

		.site-footer__bar {
			flex-direction: column;
			align-items: flex-start;
		}

		.site-footer__note {
			text-align: left;
			max-width: none;
		}
	}
</style>
