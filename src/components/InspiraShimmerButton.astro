---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'> & {
	href: string;
	shimmerColor?: string;
	shimmerSize?: string;
	borderRadius?: string;
	shimmerDuration?: string;
	background?: string;
};

const {
	href,
	class: className,
	shimmerColor = 'rgba(255, 255, 255, 0.72)',
	shimmerSize = '1px',
	borderRadius = '0.95rem',
	shimmerDuration = '3s',
	background = 'var(--color-button)',
	...attrs
} = Astro.props;
---

<a
	href={href}
	class:list={['inspira-shimmer-btn', className]}
	style={{
		'--spread': '90deg',
		'--shimmer-color': shimmerColor,
		'--radius': borderRadius,
		'--speed': shimmerDuration,
		'--cut': shimmerSize,
		'--bg': background,
	}}
	{...attrs}
>
	<span class="inspira-shimmer-btn__fx" aria-hidden="true">
		<span class="inspira-shimmer-btn__slide">
			<span class="inspira-shimmer-btn__spin"></span>
		</span>
		<span class="inspira-shimmer-btn__highlight"></span>
		<span class="inspira-shimmer-btn__inset-bg"></span>
	</span>
	<span class="inspira-shimmer-btn__label">
		<slot />
	</span>
</a>

<style>
	.inspira-shimmer-btn {
		position: relative;
		z-index: 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: var(--radius);
		background: var(--bg);
		color: #ffffff;
		font: inherit;
		text-decoration: none;
		cursor: pointer;
		container-type: size;
		isolation: isolate;
		transition:
			transform 0.3s ease,
			filter 0.2s ease,
			box-shadow 0.2s ease;
	}

	.inspira-shimmer-btn:hover,
	.inspira-shimmer-btn:focus-visible {
		color: #ffffff;
		filter: brightness(1.05);
	}

	.inspira-shimmer-btn:active {
		transform: translateY(1px);
	}

	.inspira-shimmer-btn__fx {
		position: absolute;
		inset: 0;
		pointer-events: none;
		overflow: hidden;
		border-radius: inherit;
	}

	.inspira-shimmer-btn__slide {
		position: absolute;
		inset: 0;
		aspect-ratio: 1;
		height: 100cqh;
		animation: inspira-shimmer-slide var(--speed) ease-in-out infinite alternate;
	}

	.inspira-shimmer-btn__spin {
		position: absolute;
		inset: -100%;
		width: auto;
		background: conic-gradient(
			from calc(270deg - (var(--spread) * 0.5)),
			transparent 0,
			var(--shimmer-color) var(--spread),
			transparent var(--spread)
		);
		animation: inspira-shimmer-spin calc(var(--speed) * 2) infinite linear;
	}

	.inspira-shimmer-btn__highlight {
		position: absolute;
		inset: 0;
		border-radius: inherit;
		box-shadow: inset 0 -8px 10px rgba(255, 255, 255, 0.12);
		transition: box-shadow 0.3s ease;
	}

	.inspira-shimmer-btn:hover .inspira-shimmer-btn__highlight,
	.inspira-shimmer-btn:focus-visible .inspira-shimmer-btn__highlight {
		box-shadow: inset 0 -6px 10px rgba(255, 255, 255, 0.22);
	}

	.inspira-shimmer-btn__inset-bg {
		position: absolute;
		inset: var(--cut);
		z-index: -1;
		border-radius: var(--radius);
		background: var(--bg);
	}

	.inspira-shimmer-btn__label {
		position: relative;
		z-index: 2;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: inherit;
	}

	.inspira-shimmer-btn__label :global(svg) {
		flex-shrink: 0;
	}

	@keyframes inspira-shimmer-slide {
		to {
			transform: translate(calc(100cqw - 100%), 0);
		}
	}

	@keyframes inspira-shimmer-spin {
		0% {
			transform: translateZ(0) rotate(0);
		}
		15%,
		35% {
			transform: translateZ(0) rotate(90deg);
		}
		65%,
		85% {
			transform: translateZ(0) rotate(270deg);
		}
		100% {
			transform: translateZ(0) rotate(360deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.inspira-shimmer-btn__slide,
		.inspira-shimmer-btn__spin {
			animation: none !important;
		}
	}
</style>
