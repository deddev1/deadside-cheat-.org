---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getUi } from '../data/i18n';
import { getLocalizedPath, type PageId } from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { deadsideScreenshots } from '../data/deadside';
import { productInfo, siteConfig } from '../data/site';
import { contentSrc, contentSrcSet, galleryTileSizes } from '../lib/responsive-images';

function shopImageAttrs(src: string) {
	const imageSrc = contentSrc(src);
	const srcset = contentSrcSet(src);
	return { src: imageSrc, ...(srcset ? { srcset } : {}) };
}

interface Props {
	locale?: LocaleCode;
	pageId?: PageId;
	overlay?: boolean;
}

const { locale = defaultLocale, pageId = 'home', overlay = false } = Astro.props;
const ui = getUi(locale);
const current = Astro.url.pathname;
const homeHref = getLocalizedPath('home', locale);
const cheatsHref = getLocalizedPath('hacks', locale);
const shopLabel = 'Shop';
const pricingHref = getLocalizedPath('pricing', locale);
const featuresHref = getLocalizedPath('features', locale);
const faqHref = getLocalizedPath('faq', locale);
const reviewsHref = '/reviews/';
const blogHref = '/blog/';

const shopCards = [
	{
		title: `${productInfo.plans[0].label} — $${productInfo.plans[0].price}`,
		description:
			'ESP, aimbot, wallhack, and radar for 30 days. Anti-cheat updates while your license is active.',
		href: siteConfig.checkoutUrl,
		image: deadsideScreenshots.mainMenu.src,
		alt: deadsideScreenshots.mainMenu.alt,
	},
	{
		title: `${productInfo.plans[1].label} — $${productInfo.plans[1].price}`,
		description:
			'One-time purchase with no renewals. Full feature stack and anti-cheat updates for as long as you play.',
		href: siteConfig.checkoutUrl,
		image: deadsideScreenshots.espOverlay.src,
		alt: deadsideScreenshots.espOverlay.alt,
	},
] as const;

const centerNavLinks = [
	{ label: ui.nav.home, href: homeHref, pageId: 'home' as PageId },
	{ label: ui.nav.cheats ?? 'Cheats', href: cheatsHref, pageId: 'hacks' as PageId },
	{ label: ui.nav.pricing, href: pricingHref, pageId: 'pricing' as PageId },
	{ label: ui.nav.faq, href: faqHref, pageId: 'faq' as PageId },
	{ label: ui.nav.reviews ?? 'Reviews', href: reviewsHref },
	{ label: 'Cheats blogs', href: blogHref },
] as const;

function pathMatches(href: string, id?: PageId) {
	if (id === 'home') return current === href || current === `/${locale}/` || current === '/';
	if (id === 'hacks') {
		return current === href || current.startsWith(href) || current.startsWith('/deadside-cheats');
	}
	if (href === '/reviews/') return current.startsWith('/reviews/');
	if (href === '/blog/') return current.startsWith('/blog/');
	if (href === '/guides/') return current.startsWith('/guides/');
	return current === href || current.startsWith(href);
}

const featureLinks = [
	{ label: 'All features', href: featuresHref, pageId: 'features' as PageId },
	{ label: ui.nav.esp, href: getLocalizedPath('deadside-esp', locale), pageId: 'deadside-esp' as PageId },
	{ label: 'Wallhack', href: getLocalizedPath('wallhack', locale), pageId: 'wallhack' as PageId },
	{ label: ui.nav.aimbot, href: getLocalizedPath('deadside-aimbot', locale), pageId: 'deadside-aimbot' as PageId },
	{ label: 'Radar', href: getLocalizedPath('radar', locale), pageId: 'radar' as PageId },
] as const;

function featureLinkActive(linkPageId: PageId): boolean {
	if (pageId === linkPageId) return true;
	const link = featureLinks.find((entry) => entry.pageId === linkPageId);
	if (!link) return false;
	return pathMatches(link.href, linkPageId);
}

const featuresActive = featureLinks.some((link) => featureLinkActive(link.pageId));
---

<header class:list={['nav', { 'nav--overlay': overlay }]} data-nav>
	<div class="nav__backdrop" data-nav-backdrop hidden aria-hidden="true"></div>

	<div class="nav__main">
		<div class="nav__bar">
			<nav class="nav__menu" id="nav-panel" data-nav-panel aria-label="Primary">
				{
					centerNavLinks.slice(0, 2).map((link) => (
						<a
							href={link.href}
							class:list={[
								'nav__menu-link',
								{ 'is-active': pathMatches(link.href, link.pageId) },
							]}
						>
							{link.label}
						</a>
					))
				}

				<div class="nav__features-wrap" data-nav-dropdown data-nav-features>
					<a
						href={featuresHref}
						class:list={['nav__menu-link', 'nav__features-trigger', { 'is-active': featuresActive }]}
						aria-haspopup="true"
						aria-expanded="false"
						data-nav-features-trigger
					>
						{ui.nav.features}
						<svg class="nav__caret" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
							<path d="M7 10l5 5 5-5H7z" fill="currentColor"></path>
						</svg>
					</a>
					<div class="nav__features-panel" role="menu" aria-label={ui.nav.features} data-nav-features-panel>
						{
							featureLinks.map((link) => (
								<a
									href={link.href}
									class:list={[
										'nav__features-panel-link',
										{ 'is-active': featureLinkActive(link.pageId) },
									]}
									role="menuitem"
									aria-current={featureLinkActive(link.pageId) ? 'page' : undefined}
								>
									{link.label}
								</a>
							))
						}
					</div>
				</div>

				{
					centerNavLinks.slice(2).map((link) => (
						<a
							href={link.href}
							class:list={[
								'nav__menu-link',
								{ 'is-active': pathMatches(link.href, link.pageId) },
							]}
						>
							{link.label}
						</a>
					))
				}
			</nav>

			<div class="nav__actions">
				<div class="nav__shop-wrap" data-nav-shop data-nav-dropdown>
					<a
						href={siteConfig.checkoutUrl}
						class="nav__shop nav__shop-trigger"
						rel="noopener noreferrer"
						aria-haspopup="true"
						aria-expanded="false"
						data-nav-shop-trigger
					>
						<svg class="nav__shop-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
							<path
								d="M7 18a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm10 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zM6.2 6h14.6l-1.4 7H8.1L6.2 6zm-.8-2 2.2 11h11.2l2-11H5.4z"
								fill="currentColor"></path>
						</svg>
						<span class="nav__shop-label">{shopLabel}</span>
						<svg class="nav__caret nav__shop-caret" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
							<path d="M7 10l5 5 5-5H7z" fill="currentColor"></path>
						</svg>
					</a>
					<div class="nav__shop-mega" role="region" aria-label={shopLabel} data-nav-shop-panel>
						<div class="nav__shop-mega-grid">
							{
								shopCards.map((card) => (
									<a href={card.href} class="nav__shop-card" rel="noopener noreferrer">
										<div class="nav__shop-card-media">
											<img
												{...shopImageAttrs(card.image)}
												sizes={galleryTileSizes}
												alt={card.alt}
												width="640"
												height="400"
												loading="lazy"
												decoding="async"
											/>
											<span class="nav__shop-card-icon" aria-hidden="true">
												<svg viewBox="0 0 24 24" focusable="false">
													<path
														d="M14 3h7v7h-2V6.41l-9.29 9.3-1.42-1.42 9.3-9.29H14V3zM5 5h6V3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-6h-2v6H5V5z"
														fill="currentColor"></path>
												</svg>
											</span>
										</div>
										<div class="nav__shop-card-body">
											<h3 class="nav__shop-card-title">{card.title}</h3>
											<p class="nav__shop-card-desc">{card.description}</p>
										</div>
									</a>
								))
							}
						</div>
					</div>
				</div>

				<LanguageSwitcher pageId={pageId} currentLocale={locale} />
				<button
					type="button"
					class="nav__toggle"
					aria-label="Open menu"
					aria-expanded="false"
					aria-controls="nav-panel"
					data-nav-toggle
				>
					<span class="nav__toggle-icon" aria-hidden="true"></span>
				</button>
			</div>
		</div>
	</div>
</header>

<script>
	const nav = document.querySelector('[data-nav]');
	if (nav) {
		const toggle = nav.querySelector('[data-nav-toggle]');
		const panel = nav.querySelector('[data-nav-panel]');

		const setOpen = (open: boolean) => {
			toggle?.setAttribute('aria-expanded', String(open));
			toggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
			nav.classList.toggle('is-open', open);
			document.body.classList.toggle('nav-open', open);
			const backdrop = nav.querySelector('[data-nav-backdrop]') as HTMLElement | null;
			if (backdrop) backdrop.hidden = !open;
		};

		toggle?.addEventListener('click', () => {
			setOpen(toggle.getAttribute('aria-expanded') !== 'true');
		});

		panel?.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => setOpen(false));
		});

		nav.addEventListener('click', (event) => {
			const target = event.target as Element;
			if (nav.classList.contains('is-open') && target.hasAttribute('data-nav-backdrop')) {
			 setOpen(false);
			}
		});

		const onScroll = () => nav.classList.toggle('is-scrolled', window.scrollY > 8);
		onScroll();
		window.addEventListener('scroll', onScroll, { passive: true });

		const closeAllDropdowns = (except?: Element | null) => {
			nav.querySelectorAll('[data-nav-dropdown]').forEach((dropdown) => {
				if (except && dropdown === except) return;
				dropdown.classList.remove('is-open');
				dropdown.querySelector('[aria-expanded]')?.setAttribute('aria-expanded', 'false');
			});
		};

		const bindShopDropdown = (dropdown: Element) => {
			const trigger = dropdown.querySelector('[data-nav-shop-trigger]') as HTMLElement | null;
			if (!trigger) return;

			let closeTimer: ReturnType<typeof setTimeout> | undefined;

			const setDropdownOpen = (open: boolean) => {
				clearTimeout(closeTimer);
				if (open) {
					closeAllDropdowns(dropdown);
					dropdown.classList.add('is-open');
					trigger.setAttribute('aria-expanded', 'true');
				} else {
					dropdown.classList.remove('is-open');
					trigger.setAttribute('aria-expanded', 'false');
				}
			};

			const scheduleClose = () => {
				clearTimeout(closeTimer);
				closeTimer = setTimeout(() => setDropdownOpen(false), 140);
			};

			if (window.matchMedia('(min-width: 961px)').matches) {
				dropdown.addEventListener('mouseenter', () => setDropdownOpen(true));
				dropdown.addEventListener('mouseleave', scheduleClose);
				dropdown.addEventListener('focusin', () => setDropdownOpen(true));
				dropdown.addEventListener('focusout', (event) => {
					if (!dropdown.contains((event as FocusEvent).relatedTarget as Node)) {
						scheduleClose();
					}
				});
			} else {
				trigger.addEventListener('click', (event) => {
					event.preventDefault();
					const isOpen = dropdown.classList.contains('is-open');
					closeAllDropdowns();
					setDropdownOpen(!isOpen);
				});
			}
		};

		const bindFeaturesDropdown = (dropdown: Element) => {
			const trigger = dropdown.querySelector('[data-nav-features-trigger]') as HTMLElement | null;
			if (!trigger) return;

			let closeTimer: ReturnType<typeof setTimeout> | undefined;

			const setDropdownOpen = (open: boolean) => {
				clearTimeout(closeTimer);
				if (open) {
					closeAllDropdowns(dropdown);
					dropdown.classList.add('is-open');
					trigger.setAttribute('aria-expanded', 'true');
				} else {
					dropdown.classList.remove('is-open');
					trigger.setAttribute('aria-expanded', 'false');
				}
			};

			const scheduleClose = () => {
				clearTimeout(closeTimer);
				closeTimer = setTimeout(() => setDropdownOpen(false), 140);
			};

			if (window.matchMedia('(min-width: 961px)').matches) {
				dropdown.addEventListener('mouseenter', () => setDropdownOpen(true));
				dropdown.addEventListener('mouseleave', scheduleClose);
				dropdown.addEventListener('focusin', () => setDropdownOpen(true));
				dropdown.addEventListener('focusout', (event) => {
					if (!dropdown.contains((event as FocusEvent).relatedTarget as Node)) {
						scheduleClose();
					}
				});
			} else {
				trigger.addEventListener('click', (event) => {
					event.preventDefault();
					const isOpen = dropdown.classList.contains('is-open');
					closeAllDropdowns();
					setDropdownOpen(!isOpen);
				});
			}
		};

		document.addEventListener('click', (event) => {
			const target = event.target as Element;
			if (!nav.contains(target)) {
				closeAllDropdowns();
			}
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') {
				if (nav.classList.contains('is-open')) {
					setOpen(false);
				}
				closeAllDropdowns();
			}
		});

		nav.querySelectorAll('[data-nav-features]').forEach(bindFeaturesDropdown);
		nav.querySelectorAll('[data-nav-shop]').forEach(bindShopDropdown);
	}
</script>

<style is:global>
	body.nav-open {
		overflow: hidden;
	}

	.nav .lang-switcher__toggle {
		border-color: rgba(255, 255, 255, 0.16);
		background: rgba(0, 0, 0, 0.28);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		color: rgba(255, 255, 255, 0.9);
		border-radius: 0.2rem;
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	.nav .lang-switcher__panel {
		border-color: rgba(255, 255, 255, 0.12);
		background: rgba(18, 16, 14, 0.92);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
	}
</style>

<style>
	.nav {
		position: sticky;
		top: 0;
		z-index: 100;
		pointer-events: none;
	}

	.nav--overlay {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		z-index: 20;
	}

	.nav--overlay .nav__main {
		padding-top: calc(0.35rem + env(safe-area-inset-top, 0px));
		background: transparent;
		border-bottom-color: transparent;
		box-shadow: none;
		backdrop-filter: none;
		-webkit-backdrop-filter: none;
	}

	.nav--overlay.is-scrolled .nav__main {
		background: rgba(17, 22, 18, 0.45);
		border-bottom-color: rgba(255, 255, 255, 0.1);
		backdrop-filter: blur(18px) saturate(1.25);
		-webkit-backdrop-filter: blur(18px) saturate(1.25);
	}

	.nav--overlay .nav__bar {
		justify-content: center;
		min-height: 3.25rem;
	}

	.nav--overlay .nav__actions {
		position: absolute;
		top: calc(0.55rem + env(safe-area-inset-top, 0px));
		right: max(var(--page-gutter), env(safe-area-inset-right, 0px));
		z-index: 6;
		margin-left: 0;
		padding: 0.3rem;
		border-radius: 0.35rem;
		border: 1px solid rgba(255, 255, 255, 0.12);
		background: rgba(17, 22, 18, 0.42);
		backdrop-filter: blur(18px) saturate(1.3);
		-webkit-backdrop-filter: blur(18px) saturate(1.3);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.08),
			0 8px 28px rgba(0, 0, 0, 0.22);
	}

	.nav--overlay .nav__actions :global(.lang-switcher__toggle) {
		background: rgba(0, 0, 0, 0.22);
		border-color: rgba(255, 255, 255, 0.14);
	}

	.nav__bar {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.75rem;
		width: 100%;
		max-width: none;
		margin-inline: auto;
		min-height: 3.5rem;
		padding-inline: max(var(--page-gutter), env(safe-area-inset-left, 0px))
			max(var(--page-gutter), env(safe-area-inset-right, 0px));
	}

	.nav__caret {
		width: 0.85rem;
		height: 0.85rem;
		opacity: 0.75;
		transition: transform 0.2s ease;
	}

	.nav__dropdown.is-open .nav__caret,
	.nav__features-wrap.is-open .nav__caret,
	.nav__shop-wrap.is-open .nav__shop-caret {
		transform: rotate(180deg);
	}

	.nav__main {
		position: relative;
		width: 100%;
		overflow: visible;
		pointer-events: auto;
		font-family: var(--font-display);
		-webkit-font-smoothing: antialiased;
		background: rgba(17, 22, 18, 0.38);
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.06),
			0 8px 32px rgba(0, 0, 0, 0.18);
		backdrop-filter: blur(20px) saturate(1.35);
		-webkit-backdrop-filter: blur(20px) saturate(1.35);
		transition:
			background 0.25s ease,
			border-color 0.25s ease,
			box-shadow 0.25s ease;
	}

	.nav.is-scrolled .nav__main {
		background: rgba(17, 22, 18, 0.58);
		border-bottom-color: rgba(255, 255, 255, 0.14);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.08),
			0 10px 36px rgba(0, 0, 0, 0.28);
	}


	.nav__menu {
		position: absolute;
		left: 50%;
		top: 0;
		bottom: 0;
		display: flex;
		align-items: stretch;
		justify-content: center;
		width: max-content;
		max-width: calc(100% - 12rem);
		flex-wrap: nowrap;
		gap: 0.1rem;
		min-width: 0;
		overflow: visible;
		transform: translateX(-50%);
		pointer-events: auto;
	}

	.nav__menu-link,
	.nav__menu-link--dropdown {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0 0.9rem;
		min-height: 3.5rem;
		color: var(--color-muted);
		font-family: inherit;
		font-size: 0.8125rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		text-decoration: none;
		border: 0;
		background: transparent;
		transition:
			color 0.2s ease,
			background 0.2s ease;
		white-space: nowrap;
		line-height: 1.2;
	}

	.nav__menu > :first-child {
		border-left: 0;
	}

	.nav__menu-link--accent {
		color: var(--color-muted);
	}

	.nav__menu-link--accent:hover,
	.nav__menu-link--accent.is-active {
		color: #fff;
	}

	.nav__menu-link:hover,
	.nav__menu-link.is-active,
	.nav__menu-link--dropdown:hover,
	.nav__menu-link--dropdown.is-active {
		color: #fff;
	}

	.nav__menu-link--dropdown {
		cursor: pointer;
		font: inherit;
	}

	.nav__dropdown {
		position: relative;
	}

	.nav__dropdown-panel {
		position: absolute;
		top: 100%;
		left: 0;
		z-index: 120;
		min-width: 12.5rem;
		padding: 0.45rem 0;
		border: 1px solid var(--color-border-subtle);
		background: rgba(24, 22, 20, 0.98);
		box-shadow: 0 16px 36px rgba(0, 0, 0, 0.45);
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transform: translateY(-4px);
		transition:
			opacity 0.18s ease,
			transform 0.18s ease,
			visibility 0.18s ease;
	}

	.nav__dropdown.is-open .nav__dropdown-panel,
	.nav__dropdown:focus-within .nav__dropdown-panel {
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
		transform: translateY(0);
	}

	.nav__dropdown-link {
		display: block;
		padding: 0.55rem 1.15rem;
		color: rgba(255, 255, 255, 0.82);
		font-size: 0.84rem;
		font-weight: 500;
		letter-spacing: 0;
		text-transform: none;
		text-decoration: none;
		transition:
			color 0.2s ease,
			background 0.2s ease;
	}

	.nav__dropdown-link:hover,
	.nav__dropdown-link.is-active {
		color: #fff;
		background: rgba(255, 255, 255, 0.06);
	}

	.nav__actions {
		position: relative;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.5rem;
		flex-shrink: 0;
		margin-left: auto;
		padding-left: 0;
	}

	.nav__actions .nav__shop-wrap {
		margin-left: 0;
		align-self: center;
	}

	.nav__actions .nav__shop {
		box-sizing: border-box;
	}

	.nav__actions :global(.lang-switcher) {
		display: flex;
		align-items: center;
	}

	.nav__actions :global(.lang-switcher__toggle) {
		min-height: 2.35rem;
		align-self: center;
		font-family: var(--font-display);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		border-color: rgba(111, 143, 58, 0.28);
		background: rgba(17, 22, 18, 0.65);
		color: var(--color-muted);
	}

	.nav__features-wrap {
		position: relative;
		display: inline-flex;
		align-items: stretch;
		align-self: stretch;
		flex-shrink: 0;
	}

	.nav__features-trigger {
		height: 100%;
	}

	.nav__features-wrap.is-open,
	.nav__features-wrap:hover {
		background: rgba(12, 12, 12, 0.98);
	}

	.nav__features-wrap.is-open .nav__features-trigger,
	.nav__features-wrap:hover .nav__features-trigger {
		color: #fff;
		background: transparent;
	}

	.nav__features-panel {
		position: absolute;
		top: calc(100% - 1px);
		left: 0;
		z-index: 140;
		display: flex;
		flex-direction: column;
		width: max-content;
		min-width: 100%;
		max-height: min(18rem, calc(100vh - 8rem));
		padding: 0.35rem 0;
