---
import BlogPostPage from '../../../components/BlogPostPage.astro';
import { getAllPostsForLocale, getPostBySlug } from '../../../data/blog/helpers';
import { defaultLocale } from '../../../data/i18n/locales';

export function getStaticPaths() {
	return getAllPostsForLocale(defaultLocale).map((post) => ({
		params: { slug: post.translation.slug },
		props: { post },
	}));
}

const { post } = Astro.props;
const live = getPostBySlug(defaultLocale, post.translation.slug) ?? post;
---

<BlogPostPage locale="en" post={live} />
